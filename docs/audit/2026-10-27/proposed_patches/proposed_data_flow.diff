+_CLOCKS = {"KRX": "15:30 KST (06:30 UTC)", "US": "16:00 ET (20:00-21:00 UTC)", "UTC0": "00:00 UTC (crypto day)"}
+
+
+def close_clock(h: "History") -> str:
+    """DF-02: which close a daily date label stands for: 'KRX', 'US', 'UTC0' (crypto), '' when unknown."""
+    s, src = h.symbol.upper(), h.source
+    if src in ("UPBIT", "BINANCE") or _looks_crypto(s) or s.endswith(("-USD", "-KRW")):
+        return "UTC0"
+    if _looks_krx(s) or s in ("^KS11", "^KS200", "^KQ11"):
+        return "KRX"
+    if ":" in s:
+        return "US" if s.split(":", 1)[0] in ("NAS", "NYS", "AMS") else ""
+    if src in ("FMP", "YFINANCE") and "." not in s and s.replace("-", "").isalnum():
+        return "US"
+    return ""
+
+
+def mixed_close_warning(hists) -> str:
+    """DF-02: one sentence when a panel aligns venues whose closes are hours apart on one date label."""
+    by: dict[str, list[str]] = {}
+    for h in hists:
+        c = close_clock(h)
+        if c:
+            by.setdefault(c, []).append(h.symbol)
+    if len(by) < 2:
+        return ""
+    parts = "; ".join(f"{', '.join(v)} close at {_CLOCKS[k]}" for k, v in by.items())
+    return (f"Mixed close times: {parts}. Same-date daily returns understate their co-movement, and a rule that "
+            f"reads both closes of one date uses news the earlier market had not yet seen.")
+
