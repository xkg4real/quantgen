+def test_missing_sessions_are_reported_against_the_calendar_and_never_filled():
+    days = [date(2026, 3, 2) + timedelta(days=i) for i in range(30)]
+    us = [d.isoformat() for d in days if d.weekday() < 5]
+    gappy = [d for d in us if d != "2026-03-11"] + ["2026-03-28"]      # a Wednesday missing, a Saturday row
+    missing, extra, unknown = gap_report(sorted(gappy), "US")
+    assert missing == ("2026-03-11",) and extra == ("2026-03-28",) and unknown == 0
+    btc = [d.isoformat() for d in days if d.isoformat() != "2026-03-15"]
+    assert gap_report(btc, "CRYPTO")[0] == ("2026-03-15",)
+    old = [(date(2024, 1, 1) + timedelta(days=i)).isoformat() for i in range(10)]
+    assert gap_report(old, "US") == ((), (), 10), "outside coverage is unjudged, never open"
+    h = History("AAPL", "FMP", tuple(sorted(gappy)), tuple(100.0 + i for i in range(len(gappy))))
+    note = H._gap_note(h, "FMP")
+    assert "1 US session(s) missing against the calendar (2026-03-11)" in note and "non-sessions" in note
+    assert len(h) == len(gappy), "a gap is reported, never filled"
+
