+def test_a_cache_file_holding_infinity_is_refetched_not_served():
+    with tempfile.TemporaryDirectory() as tmp:
+        saved_env = os.environ.get("NEXTGEN_FICC_CACHE")
+        os.environ["NEXTGEN_FICC_CACHE"] = tmp
+        calls = []
+
+        def fetch(symbol, days):
+            calls.append(symbol)
+            return History(symbol, "FMP", tuple(d for d, _ in ROWS), tuple(c for _, c in ROWS))
+        try:
+            with _patched(H, _READY={"FMP": lambda: True}, _may_be_trading=lambda *a, **k: False,
+                          _traded_since=lambda *a, **k: False):
+                name = "HIST_FMP_ABC_40.json"
+                with open(os.path.join(tmp, name), "w", encoding="utf-8") as fh:
+                    fh.write(json.dumps({"ts": __import__("time").time(), "live": False, "symbol": "ABC",
+                                         "source": "FMP", "note": "", "dates": [d for d, _ in ROWS],
+                                         "closes": [math.inf] + [c for _, c in ROWS[1:]]}))
+                h = H._cached("FMP", fetch, "ABC", 40)
+                assert calls == ["ABC"] and all(math.isfinite(c) for c in h.closes)
+        finally:
+            if saved_env is None:
+                os.environ.pop("NEXTGEN_FICC_CACHE", None)
+            else:
+                os.environ["NEXTGEN_FICC_CACHE"] = saved_env
