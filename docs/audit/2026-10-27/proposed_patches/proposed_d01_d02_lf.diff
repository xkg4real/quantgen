+@dataclass(frozen=True)
+class CleanReport:
+    """What cleaning did to a provider's rows. `note()` goes into `History.note`: nothing is dropped unsaid."""
+    bad_date: int = 0
+    non_numeric: int = 0
+    non_finite: int = 0
+    non_positive: tuple[str, ...] = ()
+    merged_duplicates: int = 0
+    revised_last: str = ""
+    spikes: tuple[str, ...] = ()
+
+    def note(self) -> str:
+        def few(xs):
+            return ", ".join(xs[:3]) + (" ..." if len(xs) > 3 else "")
+        parts = []
+        if self.bad_date:
+            parts.append(f"{self.bad_date} row(s) with an unreadable date dropped")
+        if self.non_numeric:
+            parts.append(f"{self.non_numeric} row(s) without a numeric close dropped")
+        if self.non_finite:
+            parts.append(f"{self.non_finite} NaN/inf close(s) dropped")
+        if self.non_positive:
+            parts.append(f"{len(self.non_positive)} close(s) at or below zero dropped ({few(self.non_positive)})")
+        if self.merged_duplicates:
+            parts.append(f"{self.merged_duplicates} repeated row(s) of one session merged")
+        if self.revised_last:
+            parts.append(f"two different closes for {self.revised_last}; the later row kept")
+        if self.spikes:
+            parts.append(f"move over {SPIKE_LOG_MOVE:.0%} on {few(self.spikes)} kept, check it")
+        return "; ".join(parts)
+
+
+def _iso_day(text) -> str:
+    """'2026-01-05', '20260105' or '2026-01-05T00:00:00' -> '2026-01-05'; anything else -> ''."""
+    t = str(text or "").strip()
+    if len(t) >= 8 and t[:8].isdigit():
+        t = f"{t[:4]}-{t[4:6]}-{t[6:8]}"
+    t = t[:10]
+    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", t):
+        return ""
+    try:
+        return date.fromisoformat(t).isoformat()
+    except ValueError:
+        return ""
+
+
+def _spikes(dates: tuple[str, ...], closes: tuple[float, ...]) -> tuple[str, ...]:
+    if len(closes) < 3:
+        return ()
+    lr = np.diff(np.log(np.asarray(closes, dtype=float)))
+    robust_sigma = 1.4826 * float(np.median(np.abs(lr - np.median(lr))))
+    bound = max(SPIKE_LOG_MOVE, 8.0 * robust_sigma)
+    return tuple(dates[i + 1] for i in np.flatnonzero(np.abs(lr) > bound))
+
+
+def clean_rows(rows, *, positive: bool = True,
+               label: str = "") -> tuple[tuple[str, ...], tuple[float, ...], CleanReport]:
+    """A provider's `(date, close)` rows -> ascending ISO dates, one close per session, and a report.
+
+    * date: an ISO day (YYYYMMDD and ISO datetimes are normalised); anything else is dropped and counted.
+    * close: a real number (a bool is refused); NaN and +-inf are dropped and counted. For a price
+      (`positive`) a close at or below zero is dropped and its dates are named: a log return cannot hold it.
+      A rate series passes `positive=False` and keeps zero and negative values.
+    * several rows for one session: identical closes merge (counted). Different closes on the LAST session
+      keep the later row (a running bar re-issued). Different closes on an earlier session raise
+      `HistoryError` naming both: which one is true cannot be decided here. Precedence between providers
+      belongs to the PIT store (`core.ficc.pit._best_per_obs`); a History holds one provider.
+    * large moves are flagged in the report and never removed (audit request, section 6).
+    """
+    bad_date = non_numeric = non_finite = 0
+    non_positive: list[str] = []
+    by_day: dict[str, list[float]] = {}
+    for d, c in rows:
+        day = _iso_day(d)
+        if not day:
+            bad_date += 1
+            continue
+        if c is None or isinstance(c, bool):
+            non_numeric += 1
+            continue
+        try:
+            v = float(c)
+        except (TypeError, ValueError):
+            non_numeric += 1
+            continue
+        if not math.isfinite(v):
+            non_finite += 1
+            continue
+        if positive and v <= 0:
+            non_positive.append(day)
+            continue
+        by_day.setdefault(day, []).append(v)
+    days = sorted(by_day)
+    merged, revised, conflicts, closes = 0, "", [], []
+    for i, day in enumerate(days):
+        vals = by_day[day]
+        if all(math.isclose(v, vals[0], rel_tol=_SAME_CLOSE_RTOL, abs_tol=0.0) for v in vals[1:]):
+            merged += len(vals) - 1
+        elif i == len(days) - 1:
+            revised = day
+        else:
+            conflicts.append(f"{day}: {' vs '.join(f'{v:g}' for v in vals)}")
+        closes.append(vals[-1])
+    if conflicts:
+        raise HistoryError(f"{label or 'The provider'} returned different closes for one session "
+                           f"({'; '.join(conflicts[:3])}{' ...' if len(conflicts) > 3 else ''}). Which one is "
+                           "right cannot be decided here, so nothing was computed.")
+    ds, cs = tuple(days), tuple(closes)
+    report = CleanReport(bad_date, non_numeric, non_finite, tuple(sorted(non_positive)), merged, revised,
+                         _spikes(ds, cs) if positive else ())
+    return ds, cs, report
+
+
+def _clean_rows(rows) -> tuple[tuple[str, ...], tuple[float, ...]]:
+    """Kept for callers outside this module. New code calls `clean_rows` and puts the report in the note."""
+    ds, cs, _ = clean_rows(rows)
+    return ds, cs
+
+
+def _with_note(note: str, report: CleanReport) -> str:
+    return "; ".join(x for x in (note, report.note()) if x)
+
+
+def _well_formed(dates, closes) -> bool:
+    """A stored series is served only if it is exactly what `clean_rows` would hand out."""
+    return (len(dates) == len(closes)
+            and all(isinstance(d, str) and _iso_day(d) == d for d in dates)
+            and all(a < b for a, b in zip(dates, dates[1:]))
+            and all(isinstance(c, (int, float)) and not isinstance(c, bool) and math.isfinite(c) for c in closes))
+
+
+def _market_of(provider: str, symbol: str) -> str:
+    s = symbol.upper()
+    if provider == "CRYPTO":
+        return "CRYPTO"
+    if provider in ("KIS", "YFINANCE") and _looks_krx(s):
+        return "KRX"
+    if (provider == "FMP" and "." not in s) or (provider == "KIS" and s.split(":")[0] in ("NAS", "NYS", "AMS")):
+        return "US"
+    return ""
+
+
+def gap_report(dates, market: str) -> tuple[tuple[str, ...], tuple[str, ...], int]:
+    """(sessions missing, rows on non-sessions, days the calendar could not judge) from the first to the last date.
+    CRYPTO trades every UTC day; KRX and US use `core.calendars` inside its generated coverage, and a day outside
+    it is counted as unjudged, never as open. Reported only: nothing is filled or removed."""
+    if not market or len(dates) < 2:
+        return (), (), 0
+    from core import calendars
+    have = set(dates)
+    d, hi = date.fromisoformat(dates[0]), date.fromisoformat(dates[-1])
+    missing, extra, unknown = [], [], 0
+    while d <= hi:
+        open_ = True if market == "CRYPTO" else calendars.is_trading_day(market, d)
+        if open_ is None:
+            unknown += 1
+        elif open_ and d.isoformat() not in have:
+            missing.append(d.isoformat())
+        elif not open_ and d.isoformat() in have:
+            extra.append(d.isoformat())
+        d += timedelta(days=1)
+    return tuple(missing), tuple(extra), unknown
+
+
+def _gap_note(h: "History", provider: str) -> str:
+    market = _market_of(provider, h.symbol)
+    missing, extra, unknown = gap_report(h.dates, market)
+    few = lambda xs: ", ".join(xs[:3]) + (" ..." if len(xs) > 3 else "")      # noqa: E731
+    parts = []
+    if missing:
+        parts.append(f"{len(missing)} {market} session(s) missing against the calendar ({few(missing)}); "
+                     "the return across each gap spans more than one session")
+    if extra:
+        parts.append(f"{len(extra)} row(s) on {market} non-sessions ({few(extra)})")
+    if unknown:
+        parts.append(f"{unknown} day(s) outside the {market} calendar coverage were not checked for gaps")
+    return "; ".join(parts)
 
 
