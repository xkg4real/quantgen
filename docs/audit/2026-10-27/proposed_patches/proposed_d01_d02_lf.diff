+def test_every_provider_path_applies_the_rule():
+    import core.ficc.data as ficc
+    import data.crypto.crypto_client as cc
+    import data.kis_markets as km
+    import data.krx.kis_client as kis
+    recs = [{"date": d, "adjClose": c} for d, c in ROWS]
+    body = json.dumps(recs).replace('"adjClose": 110.0', '"adjClose": Infinity')
+    with _patched(config, fmp_key=lambda: "K", kis_ready=lambda: True), _patched(H, _requests=_HTTP(body)):
+        h = H.fmp_history("KO", days=60)
+        assert all(math.isfinite(c) for c in h.closes) and "1 NaN/inf close(s) dropped" in h.note
+
+    class _KIS:
+        def daily(self, code, start=None, end=None):
+            if end is not None:
+                return []
+            rows = [{"date": d, "close": c} for d, c in ROWS]
+            rows[10]["close"] = kis._f("inf")
+            return rows + [{"date": ROWS[20][0], "close": 999.0}]
+
+    with _patched(config, kis_ready=lambda: True), _patched(kis, KISClient=_KIS):
+        try:
+            H.kis_history("005930", days=60)
+        except HistoryError as exc:
+            assert ROWS[20][0] in str(exc)
+        else:
+            raise AssertionError("KIS: a duplicate inside one page must not be overwritten silently")
+    with _patched(ficc, _yf_fetch=lambda t, p: {t[0]: ROWS[:12] + [(ROWS[12][0], math.inf)] + ROWS[13:]}):
+        h = H.yf_history("ZZZ", days=60)
+        assert len(h) == 39 and all(math.isfinite(c) for c in h.closes)
+    candles = cc.Candles("KRW-BTC", tuple(d for d, _ in ROWS), tuple(0.0 if i == 3 else c for i, (_, c) in enumerate(ROWS)),
+                         source="UPBIT")
+    h = candles.to_history()
+    assert 0.0 not in h.closes and "at or below zero dropped" in h.note
+    rows = [{"stck_bsop_date": d.replace("-", ""), "ovrs_nmix_prpr": str(v)} for d, v in
+            zip((d for d, _ in ROWS), ("0.25", "0.00", "-0.05", "inf") + ("0.30",) * 36)]
+    y = km._bars("I:Y0204", rows, {"date": "stck_bsop_date", "close": "ovrs_nmix_prpr"}, positive=False)
+    assert 0.0 in y.close and -0.05 in y.close and len(y) == 39
+    assert 0.0 in y.to_history().closes, "a rate keeps zero"
