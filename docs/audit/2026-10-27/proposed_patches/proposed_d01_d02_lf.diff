+"""Acceptance checks for the price-cleaning rule (audit 2026-10-27, D-01 / D-02).
+
+Hermetic: every provider transport is a fake, credentials are patched, the cache lives in a temporary folder.
+One rule for every path that builds a `History`: NaN / inf / non-numeric / unreadable dates never survive, a
+close at or below zero is dropped and named, one session has one row, a conflicting session is refused, a
+large move is flagged and kept, and a missing session is reported and never filled.
+"""
+from __future__ import annotations
+
+import contextlib
+import json
+import math
+import os
+import tempfile
+from datetime import date, timedelta
+
+import config
+import core.quant.history as H
+from core.quant.history import History, HistoryError, clean_rows, gap_report
+
+ROWS = [(f"2026-{1 + i // 28:02d}-{1 + i % 28:02d}", 100.0 + i) for i in range(40)]
+
+
+@contextlib.contextmanager
+def _patched(obj, **attrs):
+    saved = {k: getattr(obj, k) for k in attrs}
+    for k, v in attrs.items():
+        setattr(obj, k, v)
+    try:
+        yield
+    finally:
+        for k, v in saved.items():
+            setattr(obj, k, v)
+
+
+def test_non_finite_and_non_numeric_closes_never_survive_and_are_counted():
+    rows = list(ROWS)
+    rows[3] = (rows[3][0], math.inf)
+    rows[4] = (rows[4][0], -math.inf)
+    rows[5] = (rows[5][0], math.nan)
+    rows[6] = (rows[6][0], "inf")
+    rows[7] = (rows[7][0], "abc")
+    rows[8] = (rows[8][0], None)
+    rows[9] = (rows[9][0], True)
+    ds, cs, rep = clean_rows(rows)
+    assert all(math.isfinite(c) and c > 0 for c in cs) and len(cs) == 33
+    assert (rep.non_finite, rep.non_numeric) == (4, 3), rep
+    assert "4 NaN/inf close(s) dropped" in rep.note() and "3 row(s) without a numeric close dropped" in rep.note()
+
+
+def test_a_close_at_or_below_zero_is_dropped_and_named_unless_the_series_is_a_rate():
+    rows = list(ROWS)
+    rows[10] = ("2026-01-11", -37.63)
+    rows[11] = ("2026-01-12", 0.0)
+    ds, cs, rep = clean_rows(rows)
+    assert "2026-01-11" not in ds and rep.non_positive == ("2026-01-11", "2026-01-12")
+    assert "2 close(s) at or below zero dropped (2026-01-11, 2026-01-12)" in rep.note()
+    ds, cs, rep = clean_rows(rows, positive=False)
