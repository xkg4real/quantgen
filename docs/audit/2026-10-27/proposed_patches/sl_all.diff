+def _tick_floor_bp(symbol: str, hist) -> float:
+    """P10 / R-26: max(table, commission + half a tick / price) for an instrument QUANTGEN registers, at the
+    latest close (as macro_daily prices it; the floor only raises). 0 outside the registry or on synthetic data,
+    whose price level is not a market price."""
+    from core.quant import instruments as INS
+    code = symbol.strip().upper().split(".")[0]
+    if code not in INS.INSTRUMENTS or hist.source == "SYNTHETIC":
+        return 0.0
+    try:
+        return INS.cost_per_side(code, price=float(hist.prices()[-1])).bp
+    except INS.NotTradable:
+        return 0.0
+
