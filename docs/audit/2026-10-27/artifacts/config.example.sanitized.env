# NEXTGEN_FMP_MIN_INTERVAL=20                                    # config.py:68, seconds
# KIS_BASE_URL=https://openapi.koreainvestment.com:9443         # config.py:84
# OPENDART_BASE_URL=https://opendart.fss.or.kr/api               # config.py:127
# KRX_BASE_URL=https://data-dbg.krx.co.kr/svc/apis               # config.py:141
# NEXTGEN_HTTP_TIMEOUT=12                                        # config.py:145, seconds
# NEXTGEN_TRADING_DIR=                                           # config.py:170, default ~/.nextgen/trading
# QUANTGEN_MACRO_DIR=                                            # config.py:177, default ~/.nextgen/macro (README mentions it)
# NEXTGEN_QUOTE_MAX_AGE=120                                      # config.py:182, seconds
# NEXTGEN_ENGINE_TICK=5                                          # config.py:185, seconds
# FRED_BASE_URL=https://fred.stlouisfed.org/graph/fredgraph.csv  # config.py:271
# QUANTGEN_TECTONIC=                                             # tools/paper/build.py:64, path to tectonic (papers suite)
# QUANTGEN_AGY=                                                  # tools/debate.py:47, default is a hard-coded Windows user path
