# QUANTGEN sanitized configuration example (audit artifact, 2026-10-27).
# Derived ONLY from the tracked .env.example and config.py defaults. The real .env was not opened.
# Every credential value is empty on purpose; never paste real values into a shared file.
# Lines below the marker are environment variables the code reads (config.py, tools/) that
# .env.example does not list; their values are the code defaults (non-secret).

# QUANTGEN credentials. Copy to .env and fill in what you have.
# Every key is optional — with none set, the quant pages run on clearly
# labeled synthetic data and the KRX and Settings pages report what is missing.

# --- Market data ------------------------------------------------------------
FMP_API_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
OPENDART_API_KEY=
KRX_API_KEY=

# --- Quant analysis ---------------------------------------------------------
# Claude API key: unlocks "Deep analysis" on the Quant Lab / Portfolio /
# Signals pages. Without it, the local deterministic narrative still renders.
ANTHROPIC_API_KEY=
QUANTGEN_AI_MODEL=claude-sonnet-5

# GS Marquee OAuth application credentials: unlocks gs_quant's session tier
# (instrument pricing). gs_quant's offline analytics need no credentials.
GS_CLIENT_ID=
GS_CLIENT_SECRET=

# --- Crypto (version 3) ------------------------------------------------------
# Upbit and Binance public data are keyless. An Upbit key is OPTIONAL and only
# reads balances: issue it with 자산조회 (asset inquiry) scope ONLY, allow-list
# this machine's IP, and note that Upbit keys expire after one year. QUANTGEN
# never submits orders, withdrawals or transfers, and never holds a wallet key.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# --- FICC (rates / bonds / FX / macro) --------------------------------------
# No keys needed: the Rates, Bonds, FX, Macro and Structuring pages read the
# US Treasury curve, SOFR, credit spreads and FX fixings from FRED and Yahoo
# Finance, both keyless. Fetches are cached on disk; override the location or
# the time-to-live if you want. The same cache and TTL also hold every price
# history loaded by the quant pages (FMP, KIS, Yahoo, crypto); 0 disables it.
NEXTGEN_FICC_CACHE=
NEXTGEN_FICC_CACHE_TTL=21600

# --- Engine ------------------------------------------------------------------
# Passes a symbol's quote may be missing (timeout, 5xx, rate limit) before the
# engine halts; 0-10. Nothing fires during the window. 0 = halt on the first
# miss, as before. A plan refusal or missing key halts at once regardless.
NEXTGEN_NO_DATA_GRACE=3

# ---- not in .env.example (read by the code; defaults from config.py / tools) ----
