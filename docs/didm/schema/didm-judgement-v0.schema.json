{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "didm-judgement-v0.schema.json",
  "title": "didm-judgement-v0",
  "description": "What a scorer returns for one article and one target. DIDM assembles the didm-score-v0 record from it. Generated by tools/didm/export_schema.py from core/didm/llm/judgement.py; do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "judgement_version",
    "article_id",
    "target_kind",
    "entity_id",
    "p_subject",
    "event_type",
    "event_type_probs",
    "direction_probs",
    "claim_status"
  ],
  "properties": {
    "judgement_version": {
      "const": "didm-judgement-v0"
    },
    "article_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$(?!\\n)"
    },
    "target_kind": {
      "enum": [
        "firm",
        "macro",
        "none"
      ]
    },
    "entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "p_subject": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "event_type": {
      "enum": [
        "monetary_policy",
        "inflation",
        "employment",
        "growth",
        "fiscal",
        "trade_tariffs",
        "geopolitics",
        "election_policy",
        "earnings",
        "mergers_acquisitions",
        "management",
        "regulation_litigation",
        "supply_chain",
        "crypto_regulation_hack",
        "none"
      ]
    },
    "event_type_probs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monetary_policy",
        "inflation",
        "employment",
        "growth",
        "fiscal",
        "trade_tariffs",
        "geopolitics",
        "election_policy",
        "earnings",
        "mergers_acquisitions",
        "management",
        "regulation_litigation",
        "supply_chain",
        "crypto_regulation_hack",
        "none"
      ],
      "properties": {
        "monetary_policy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "inflation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "employment": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "growth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fiscal": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "trade_tariffs": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "geopolitics": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "election_policy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "earnings": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mergers_acquisitions": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "management": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "regulation_litigation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "supply_chain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "crypto_regulation_hack": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "none": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "direction_probs": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ],
      "minItems": 3,
      "maxItems": 3,
      "description": "[P(+1), P(-1), P(0)]"
    },
    "claim_status": {
      "enum": [
        "reported",
        "confirmed"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "target_kind": {
            "const": "none"
          }
        },
        "required": [
          "target_kind"
        ]
      },
      "then": {
        "properties": {
          "entity_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$(?!\\n)"
          }
        }
      }
    }
  ],
  "x-didm-cross-field-rules": [
    "article_id, target_kind and entity_id equal the request's",
    "p_subject is 0 when target_kind is none",
    "event_type_probs sums to 1 within 1e-06",
    "event_type is a most probable key of event_type_probs (compared exactly; an exact tie leaves a choice)",
    "direction_probs sums to 1 within 1e-06",
    "P(+1) + P(-1) does not exceed 1 (tolerance 1e-9)"
  ]
}
