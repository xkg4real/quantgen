{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "didm-score-v0.schema.json",
  "title": "didm-score-v0",
  "description": "One DIDM score record: one article judged for one target. Generated by tools/didm/export_schema.py from core/didm/llm/schema.py; do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "source_id",
    "target_kind",
    "entity_id",
    "published_at",
    "received_at",
    "relevance_0_100",
    "ess_like_0_100",
    "novelty_0_100",
    "origin_cluster_id",
    "event_type",
    "direction_probs",
    "uncertainty_entropy",
    "p_credibility",
    "market_confirmation",
    "model_version",
    "prompt_sha256"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$(?!\\n)"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$(?!\\n)"
    },
    "target_kind": {
      "enum": [
        "firm",
        "macro",
        "none"
      ]
    },
    "entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 with a timezone; a value without one is rejected."
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 with a timezone; a value without one is rejected."
    },
    "relevance_0_100": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "ess_like_0_100": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "novelty_0_100": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "origin_cluster_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$(?!\\n)"
    },
    "event_type": {
      "enum": [
        "monetary_policy",
        "inflation",
        "employment",
        "growth",
        "fiscal",
        "trade_tariffs",
        "geopolitics",
        "election_policy",
        "earnings",
        "mergers_acquisitions",
        "management",
        "regulation_litigation",
        "supply_chain",
        "crypto_regulation_hack",
        "none"
      ]
    },
    "direction_probs": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ],
      "minItems": 3,
      "maxItems": 3,
      "description": "[P(+1), P(-1), P(0)]"
    },
    "uncertainty_entropy": {
      "type": "number"
    },
    "p_credibility": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "market_confirmation": {
      "enum": [
        "CONFIRMED",
        "CONTRADICTED",
        "ALREADY_PRICED",
        "PENDING"
      ]
    },
    "model_version": {
      "type": "string",
      "pattern": "\\S"
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?!\\n)"
    },
    "schema_version": {
      "const": "didm-score-v0"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "target_kind": {
            "const": "none"
          }
        },
        "required": [
          "target_kind"
        ]
      },
      "then": {
        "properties": {
          "entity_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$(?!\\n)"
          }
        }
      }
    }
  ],
  "x-didm-cross-field-rules": [
    "direction_probs sums to 1 within 1e-6",
    "P(+1) + P(-1) does not exceed 1 (tolerance 1e-9)",
    "ess_like_0_100 equals 50 + 50*(P(+1) - P(-1)) within 1e-6",
    "uncertainty_entropy equals the Shannon entropy (nats) of direction_probs within 1e-6",
    "published_at and received_at carry a timezone"
  ],
  "x-didm-assembled-by-didm": [
    "record_id",
    "source_id",
    "published_at",
    "received_at",
    "relevance_0_100",
    "novelty_0_100",
    "origin_cluster_id",
    "p_credibility",
    "market_confirmation"
  ],
  "x-didm-derived-on-assembly": [
    "ess_like_0_100",
    "uncertainty_entropy"
  ],
  "x-didm-from-judgement": [
    "target_kind",
    "entity_id",
    "event_type",
    "direction_probs"
  ],
  "x-didm-from-scorer-info": [
    "model_version",
    "prompt_sha256"
  ]
}
