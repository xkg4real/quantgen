+class CurrentPageStack(QStackedWidget):
+    """Sizes to the visible form only, re-measured after styles apply (owner UI-6a).
+
+    A fixed height taken at construction missed the theme's taller inputs, so the
+    last row of the Rates and KRX forms was cut off.
+    """
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self.setSizePolicy(QSizePolicy.Policy.Preferred, QSizePolicy.Policy.Fixed)
+        self.currentChanged.connect(self._page_changed)
+
+    def _page_changed(self, *_):
+        # A different form can be taller: invalidate the cached layouts up to the scroll page.
+        self.updateGeometry()
+        parent = self.parentWidget()
+        while parent is not None:
+            if parent.layout() is not None:
+                parent.layout().invalidate()
+            parent.updateGeometry()
+            if parent.inherits("QAbstractScrollArea"):
+                break
+            parent = parent.parentWidget()
+
+    def sizeHint(self):
+        page = self.currentWidget()
+        return page.sizeHint() if page is not None else super().sizeHint()
+
+    def _content_height(self, width):
+        page = self.currentWidget()
+        if page.hasHeightForWidth() and width > 0:
+            return page.heightForWidth(width)
+        return page.sizeHint().height()
+
+    def minimumSizeHint(self):
+        # The enclosing panel may shrink to its minimum; never let that cut the form's rows.
+        page = self.currentWidget()
+        if page is None:
+            return super().minimumSizeHint()
+        return QSize(page.minimumSizeHint().width(), self._content_height(self.width()))
+
+    def hasHeightForWidth(self):
+        page = self.currentWidget()
+        return page is not None and page.hasHeightForWidth()
+
+    def heightForWidth(self, width):
+        return self._content_height(width) if self.currentWidget() is not None else super().heightForWidth(width)
+
+
