+def app_icon():
+    """Multi-size icon for the window and the Windows taskbar (owner UI-17).
+
+    The .ico carries 16-256 px images, so the taskbar gets a native size instead of
+    falling back to the Python interpreter's icon; the PNGs cover other platforms.
+    """
+    icon = QIcon()
+    assets = application_root() / "assets"
+    for name in ("icon.ico", "icon_192.png", "icon_512.png", "icon.png"):
+        if (assets / name).is_file():
+            icon.addFile(str(assets / name))
+    return icon
+
+
+class WheelGuard(QObject):
+    """An unfocused selector ignores the mouse wheel and scrolls the page instead (owner UI-3).
+
+    Scrolling a page used to change combo boxes, spin boxes and tabs the pointer
+    passed over. A control changes by wheel only after the user has focused it.
+    """
+    def eventFilter(self, watched, event):
+        if event.type() != QEvent.Type.Wheel or not isinstance(watched, QWidget):
+            return False
+        if isinstance(watched, QTabBar) or (isinstance(watched, (QComboBox, QAbstractSpinBox)) and not watched.hasFocus()):
+            parent = watched.parentWidget()
+            while parent is not None and not isinstance(parent, QAbstractScrollArea):
+                parent = parent.parentWidget()
+            if parent is not None:
+                QApplication.sendEvent(parent.verticalScrollBar(), event)
+            return True
+        return False
+
+
+def install_wheel_guard(app):
+    if app is not None and not app.property("qg_wheel_guard"):
+        app._qg_wheel_guard = WheelGuard(app)
+        app.installEventFilter(app._qg_wheel_guard)
+        app.setProperty("qg_wheel_guard", True)
+
