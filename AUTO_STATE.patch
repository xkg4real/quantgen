+        self.panel.setStyleSheet(f'''
+          QFrame#riskRewardPanel {{ background: {p.surface}; border: 1px solid {p.border}; border-radius: 14px; }}
+          QLabel[sd='rrRatio'] {{ font-size: 24px; font-weight: 600; color: {p.text}; letter-spacing: 0px; }}
