+            Candle(f"2026-10-{i+1:02d}", 100 + i, 102 + i, 99 + i, 101 + i, 1000) for i in range(25)))
+        self.chart.set_snapshot(self.snapshot, visible_bars=20, indicators=(), language="ko")
+        self.tool.open()
